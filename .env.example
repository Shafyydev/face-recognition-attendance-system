# =============================================================================
# Face Recognition Attendance System - Environment Configuration
# =============================================================================
# Copy this file to .env and customize the settings for your environment.
# Note: Keep your .env file secret and never commit sensitive keys to git.

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Optional: Absolute or relative path to the SQLite attendance database.
# Default: attendance.db in project root (or executable folder).
# ATTENDANCE_DB_PATH=attendance.db

# -----------------------------------------------------------------------------
# Institution / College Branding
# -----------------------------------------------------------------------------
# College name displayed in attendance reports and appended to SMS alerts
COLLEGE_NAME=St.Joseph's College of Arts & Science (Autonomous) - Cuddalore

# -----------------------------------------------------------------------------
# SMS Notification Service Configuration
# -----------------------------------------------------------------------------
# Enable or disable automated SMS notifications (true/false)
SMS_ENABLED=true

# Provider options:
#   - mock      : Logs SMS messages to terminal (useful for local development)
#   - sms-gate  : Android SMS Gate local gateway app (auto-discovers IP on LAN)
#   - textlocal : Textlocal SMS gateway
#   - fast2sms  : Fast2SMS gateway
#   - twilio    : Twilio SMS API
SMS_PROVIDER=mock

# SMS Gateway URL (for Android SMS Gate or self-hosted gateway)
# Leave blank to enable auto-discovery on local /24 subnets
SMS_API_URL=http://192.168.1.100:8080

# API credentials for third-party providers
SMS_API_KEY=
SMS_SENDER_ID=STJOSEPH
SMS_DEVICE_ID=

# -----------------------------------------------------------------------------
# Twilio Configuration (Required only if SMS_PROVIDER=twilio)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
