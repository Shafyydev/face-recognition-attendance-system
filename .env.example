# SMS Notification Configuration
# Controls whether SMS alerts are sent when students are marked late
SMS_ENABLED=true

# Provider options: 'mock', 'fast2sms', 'twilio', 'generic'
# Default is 'mock' (logs messages to console/activity without sending real SMS)
SMS_PROVIDER=mock

# SMS API Authentication / Key (if required by provider)
SMS_API_KEY=

# Sender ID / Route identifier (e.g. for Fast2SMS or DLT approved sender ID)
SMS_SENDER_ID=

# Generic HTTP webhook endpoint URL (for custom SMS gateway)
SMS_API_URL=

# Twilio Specific Settings (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
